   if(placed)
     {
      SetGridLevelState(comment, TGM_GRID_LEVEL_PENDING, g_trade.ResultOrder());
      ClearPendingClaim(comment);
      GmP11B_RegisterPlaced(g_trade.ResultOrder(), comment, levelIndex);
     }
   else
     {
      ClearGridLevelState(comment);
      ClearPendingClaim(comment);
     }
   return placed;
  }

